 {"id":"fn_cmd","type":"function","z":"tab1","name":"Command builder (interlock)","func":"// Turns UI events into PLC write operations.\n// RULE: output commands are only accepted in MANUAL mode.\nconst t = msg.topic;\nif (t === 'mode') {\n    flow.set('mode', msg.payload);\n    return [{ payload: { op: 'writeCoil', addr: 0, value: msg.payload === 'MANUAL' } },\n            { payload: 'Mode set to ' + msg.payload }];\n}\nif (t === 'reset') {\n    flow.set('mode', 'AUTO');\n    return [{ payload: { op: 'reset' } }, { payload: 'Reset sent' }];\n}\nif (t && t.startsWith('out')) {\n    if (flow.get('mode') !== 'MANUAL') {\n        return [null, { payload: 'Ignored ' + t + ': not in MANUAL mode' }];\n    }\n    const addr = Number(t.slice(3));\n    return [{ payload: { op: 'writeCoil', addr: addr, value: msg.payload === true } },\n            { payload: t + ' -> ' + msg.payload }];\n}\nreturn [null, null];","outputs":2,"timeout":0,"noerr":0,"initialize":"flow.set('mode', 'AUTO');","finalize":"","libs":[],"x":420,"y":210,"wires":[["fn_plc"],["txt_last"]]},

 {"id":"inj_poll","type":"inject","z":"tab1","name":"Poll 1 s","props":[{"p":"topic","vt":"str"}],"repeat":"1","crontab":"","once":true,"onceDelay":"1","topic":"poll","x":120,"y":420,"wires":[["fn_plc"]]},

 {"id":"fn_plc","type":"function","z":"tab1","name":"Simulated PLC (swap for real read/write nodes)","func":"// Contract: input {op:'writeCoil', addr, value} | {op:'reset'} | topic 'poll'.\n// Replace this node with your real PLC write/read nodes and keep the same outputs.\nlet plc = context.get('plc') || { coils: [false,false,false,false,false] };\nconst p = msg.payload;\nif (p && p.op === 'writeCoil') {\n    plc.coils[p.addr] = p.value;\n    if (p.addr === 0 && !p.value) { plc.coils[1] = plc.coils[2] = plc.coils[3] = plc.coils[4] = false; }\n} else if (p && p.op === 'reset') {\n    plc.coils = [false,false,false,false,false];\n}\ncontext.set('plc', plc);\nconst c = plc.coils;\nreturn [\n  { payload: c[0] ? 'MANUAL' : 'AUTO' },\n  { payload: c[1] }, { payload: c[2] }, { payload: c[3] }, { payload: c[4] }\n];","outputs":5,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":700,"y":280,"wires":[["txt_mode"],["led1"],["led2"],["led3"],["led4"]]},

